      "id": "d1000000-0000-0000-0000-000000000004",
      "name": "Inviter (Matrix)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1072, 40],
      "credentials": { "httpBearerAuth": { "id": "REMPLACE", "name": "Matrix Bot Token" } },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Compte succès / déjà présent / échec.\nconst items = $input.all();\nlet invited = 0, already = 0, failed = 0;\nfor (const it of items) {\n  const j = it.json ?? {};\n  const err = j.error;\n  if (err) {\n    const msg = String((err && (err.message || err.reason)) || JSON.stringify(err));\n    if (/already|forbidden|M_FORBIDDEN/i.test(msg)) already++; else failed++;\n  } else invited++;\n}\nconst p = $('Parse').item.json;\nconst parts = [`✅ ${invited} invité(s) dans ${p.targetLabel || 'le salon'}`];\nif (already) parts.push(`${already} déjà présent(s)`);\nif (failed) parts.push(`❌ ${failed} échec(s)`);\nreturn [{ json: { message: parts.join(' · '), reaction: invited > 0 ? '✅' : '⚠️' } }];"
      },
      "id": "d1000000-0000-0000-0000-000000000005",
      "name": "Résumé invite",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1296, 40]
    },
    {
      "parameters": {
        "jsCode": "const p = $('Parse').item.json;\nreturn [{ json: { message: `📭 Liste **${p.liste}** vide ou inexistante — personne à inviter.`, reaction: '📭' } }];"
      },
      "id": "d1000000-0000-0000-0000-000000000006",
      "name": "Invite - liste vide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
