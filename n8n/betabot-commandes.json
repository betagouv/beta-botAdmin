    },
    {
      "parameters": {
        "jsCode": "// Un item par membre à inviter.\nconst records = $json.records ?? [];\nconst p = $('Parse').item.json;\nreturn records\n  .map(r => String((r.fields ?? {}).MatrixUserId ?? '').trim())\n  .filter(Boolean)\n  .map(mxid => ({ json: { mxid, targetRoomId: p.targetRoomId, homeserver: p.homeserver } }));"
      },
      "id": "d1000000-0000-0000-0000-000000000003",
