      "typeVersion": 4.2,
      "position": [400, -200],
      "credentials": { "httpBearerAuth": { "id": "h32uPcKK6PXQuSD1", "name": "GRIST OPS" } }
    },
    {
      "parameters": {
        "jsCode": "const records = $json.records ?? [];\nconst noms = records.map(r => {\n  const f = r.fields ?? {};\n  const nom = String(f.Nom ?? '').trim();\n  const mxid = String(f.MatrixUserId ?? '').trim();\n  const fb = mxid.replace(/^@/, '').split(':')[0] ?? mxid;\n  return { nom: nom || fb, mxid };\n}).filter(m => m.mxid.length > 0);\nconst liste = String($('Parse').item.json.args || '').replace(/^[\"']|[\"']$/g, '');\nlet message, reaction;\nif (!liste) { message = '❌ Usage : `/liste-membre <nom>`'; reaction = '❌'; }\nelse if (noms.length === 0) { message = `📭 Aucune liste **${liste}** (ou elle est vide).`; reaction = '📭'; }\nelse { message = `📋 Liste **${liste}** (${noms.length} membre${noms.length > 1 ? 's' : ''}) : ${noms.map(m => m.nom).join(', ')}`; reaction = '📋'; }\nreturn [{ json: { message, reaction } }];"
      },
      "id": "a5ab6ad9-3608-4b58-8b77-303a6563f118",
      "name": "Format liste-membre",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [624, -200]
