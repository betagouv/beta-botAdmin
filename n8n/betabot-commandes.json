    {
      "parameters": {
        "jsCode": "// Corps envoyé par le bot.\nconst body = $json.body ?? $json;\nconst text = String(body.text ?? '');\nlet command = (text.trim().split(/\\s+/)[0] || '').toLowerCase();\nif (command === '/liste-membres') command = '/liste-membre';\nconst args = text.replace(/^\\/\\S+\\s*/, '').trim();\nreturn [{ json: {\n  command,\n  args,\n  text,\n  sender: body.sender ?? '',\n  roomId: body.roomId ?? '',\n  isDM: body.isDM ?? false,\n  managedSpace: body.managedSpace ?? '',\n  // Champs /invite (le bot a déjà résolu la cible).\n  liste: body.liste ?? '',\n  targetRoomId: body.targetRoomId ?? '',\n  targetLabel: body.targetLabel ?? '',\n  homeserver: String(body.homeserver ?? '').replace(/\\/$/, ''),\n} }];"
      },
