# betabot — command-only Matrix/Tchap bot.
# It only handles slash commands; it does NOT chat in natural language.

# Data directory — where the crypto store and Matrix session live (default ./data).
DATA_DIR=./data

# Matrix
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER=@betabot:example.org
# IMPORTANT: get this token from a `curl` login (m.login.password), NOT from the
# Tchap/Element web client — a browser token shares a device whose E2E is managed
# by the web client, which breaks the bot's encryption ("Déchiffrement en cours…").
# A curl login mints a fresh dedicated device the bot alone owns. See README → "Getting the access token".
MATRIX_ACCESS_TOKEN=mct_...
# MATRIX_PASSWORD=...   # alternative: the bot logs in itself at startup

# Restrict the bot to specific rooms (comma-separated room IDs).
# Leave empty to allow all rooms (default). Room IDs look like !abc123:agent.xxx.tchap.gouv.fr
# MATRIX_ALLOWED_ROOMS=!roomid1:agent.dinum.tchap.gouv.fr,!roomid2:agent.dinum.tchap.gouv.fr

# Rooms where slash commands (/help, ...) are allowed (subset of allowed rooms).
# Empty = allowed everywhere the bot responds. Set to restrict to admin/dev rooms.
# When refused, the bot replies politely and points to the rooms where the command works.
# MATRIX_COMMAND_ROOMS=!adminroom:agent.dinum.tchap.gouv.fr
# Users allowed to run slash commands in a DM with the bot, bypassing
# MATRIX_COMMAND_ROOMS. Handy for testing without posting in a shared room.
# Comma-separated mxids.
# MATRIX_DM_TEST_USERS=@toi:agent.dinum.tchap.gouv.fr
# Optional human-readable label shown in the refusal message instead of the cryptic room ID.
# MATRIX_COMMAND_ROOMS_LABEL=Salon Admin betabot
# Optional matrix.to link to that room, making the label clickable.
# MATRIX_COMMAND_ROOMS_URL=https://matrix.to/#/!adminroom:agent.dinum.tchap.gouv.fr?via=agent.dinum.tchap.gouv.fr

# Contact shown in the generic reply when someone DMs or @mentions the bot outside a command.
# MATRIX_CONTACT=beta-bot@beta.gouv.fr

# Matrix user IDs allowed to use admin commands like /historique (comma-separated).
# Empty = nobody can use admin-only commands.
# MATRIX_ADMIN_USERS=@admin1:agent.dinum.tchap.gouv.fr,@admin2:agent.dinum.tchap.gouv.fr

# Space the bot is allowed to manage rooms in, via the /salon command (create/delete).
# The bot must have power level >= the space's m.space.child requirement (usually 100).
# Empty = the /salon command is disabled.
# MATRIX_MANAGED_SPACE=!spaceid:agent.dinum.tchap.gouv.fr

# Rooms where /help shows how to file an OPS request, and where only
# /rappels-calendrier and /rappels-stop work besides it (comma-separated room IDs).
# MATRIX_OPS_ROOMS=!opsroom:agent.dinum.tchap.gouv.fr

# Automations posting commands (e.g. n8n).
# Accounts whose slash commands are accepted in rooms without @mentioning the bot.
# Default: @betabotadmin-beta.gouv.fr:agent.dinum.tchap.gouv.fr (the beta.gouv.fr bot's own account).
# MATRIX_NO_MENTION_USERS=@automation:agent.dinum.tchap.gouv.fr
# Let the bot's own account run slash commands (default false).
# MATRIX_ALLOW_SELF_COMMANDS=true
# People invited as moderators when the bot creates a room or space for itself
# (a command posted with the bot's own account). Empty = the bot is alone in it.
# MATRIX_DEFAULT_INVITES=@admin1:agent.dinum.tchap.gouv.fr,@admin2:agent.dinum.tchap.gouv.fr

# DiMail API (mailing lists / aliases) — backs the /emails command.
DIMAIL_URL=https://api.XXXX.dimail1.numerique.gouv.fr
DIMAIL_USER=
DIMAIL_PASSWORD=
DIMAIL_DOMAIN=

# Grist (stockage inscriptions rappels) — see docs/rappels-calendrier.md §3-4
# GRIST_API_URL peut inclure ou non le suffixe /api (retiré automatiquement).
GRIST_API_URL=https://grist.numerique.gouv.fr/api
GRIST_API_KEY=
# ID du Document (Grist → Paramètres → API → ID du Document).
GRIST_OPS_DOC_ID=
# IDs des tables (défauts: RappelsCalendrier / RappelsEnvoyes). Créées via
# `node --env-file=.env --import tsx scripts/grist-setup.ts`.
# GRIST_OPS_TABLE_INSCRIPTIONS=RappelsCalendrier
# GRIST_OPS_TABLE_SENT=RappelsEnvoyes

# CalDAV (La Suite / Open-Xchange) — meeting reminders, see docs/rappels-calendrier.md
# Service account credentials (Basic auth) used to read calendars.
CALDAV_USER=
CALDAV_PASSWORD=
# Page linked in the inscription DM to help find one's CalDAV URL.
# CALDAV_HELP_URL=https://messagerie.numerique.gouv.fr/appsuite/
# POC only: a single calendar URL to validate the read flow
# (node --env-file=.env --import tsx scripts/caldav-poc.ts)
# CALDAV_POC_URL=https://messagerie.numerique.gouv.fr/dav/caldav/XXXX

# Rappels de réunion — scheduler, see docs/rappels-calendrier.md §5.2
# false = scheduler arrêté (défaut true).
# RAPPELS_ENABLED=true
# ⚠️ Par défaut le scheduler tourne en DRY RUN : les rappels sont journalisés,
# PAS envoyés. Mettre false en production pour envoyer les DMs.
# RAPPELS_DRY_RUN=false
# Période du scheduler, avance du rappel sur l'événement, largeur de la
# fenêtre de détection (minutes).
# RAPPELS_INTERVAL_MIN=5
# RAPPELS_LEAD_MIN=15
# RAPPELS_WINDOW_MIN=5

# n8n — commande /invite (et /salon create --startup). Le bot forwarde la
# commande à ce webhook ; n8n lit la base espace-membre, invite, et renvoie la réponse.
N8N_MEMBRES_WEBHOOK_URL=
# Secret partagé envoyé en en-tête X-Betabot-Secret (n8n vérifie l'origine).
# N8N_WEBHOOK_SECRET=
# N8N_TIMEOUT_MS=15000
